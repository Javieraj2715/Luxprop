@* Shared/DashboardHero.razor *@
@inject NavigationManager Nav

<div class="lp-hero rounded-4 p-4 mb-4 text-white">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h1 class="hero-title text-white">@Title</h1>

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="mb-0 text-white-50">@Subtitle</p>
            }
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (!string.IsNullOrWhiteSpace(PrimaryText) && !string.IsNullOrWhiteSpace(PrimaryUrl))
            {
                <button class="btn btn-light btn-sm px-3" @onclick="() => Nav.NavigateTo(PrimaryUrl)">
                    @PrimaryText
                </button>
            }

            @if (!string.IsNullOrWhiteSpace(SecondaryText) && !string.IsNullOrWhiteSpace(SecondaryUrl))
            {
                <button class="btn btn-outline-light btn-sm px-3" @onclick="() => Nav.NavigateTo(SecondaryUrl)">
                    @SecondaryText
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Welcome back!";
    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? PrimaryText { get; set; }
    [Parameter] public string? PrimaryUrl { get; set; }

    [Parameter] public string? SecondaryText { get; set; }
    [Parameter] public string? SecondaryUrl { get; set; }
}

<style>
    .lp-hero {
        background: radial-gradient(circle at top left,#0f4e56,#159d7f);
        box-shadow: 0 18px 35px rgba(0,0,0,.22);
    }
</style>
