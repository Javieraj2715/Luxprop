@page "/properties/{propertyId:int}/tour360/edit"
@using Luxprop.Data.Models
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<LuxpropContext> DbFactory
@inject NavigationManager Navigation

<h2>Edit 360° Tour</h2>

@if (property == null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="property" OnValidSubmit="Save">
        <div class="form-group">
            <label>360° Tour URL (iframe URL)</label>
            <InputText @bind-Value="property.Recorrido360Url" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
    </EditForm>
}

@code {
    [Parameter]
    public int propertyId { get; set; }

    private Propiedad? property;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        property = await db.Propiedads.FirstOrDefaultAsync(p => p.PropiedadId == propertyId);
    }

    private async Task Save()
    {
        if (property == null) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var propDb = await db.Propiedads.FirstOrDefaultAsync(p => p.PropiedadId == propertyId);
        if (propDb == null) return;

        propDb.Recorrido360Url = property.Recorrido360Url;

        await db.SaveChangesAsync();
        Navigation.NavigateTo($"/properties/details/{propertyId}");
    }

    private void Cancel()
    {
        Navigation.NavigateTo($"/properties/details/{propertyId}");
    }
}