@page "/properties/edit/{id:int}"
@using Luxprop.Data
@using Luxprop.Data.Models
@using Luxprop.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LuxpropContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SessionService SessionService

<PageTitle>Edit Property - Luxprop</PageTitle>

<div class="create-property-page">
    <div class="page-header">
        <h1>Edit Property</h1>
        <a href="/properties" class="btn btn-secondary">Back to Properties</a>
    </div>

    @if (isLoading)
    {
        <p>Loading property...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="error-message">@errorMessage</p>
    }
    else if (property == null)
    {
        <p class="error-message">Property not found.</p>
    }
    else
    {
        <div class="form-container">
            <EditForm Model="@property" OnValidSubmit="@HandleSubmit" FormName="EditPropertyForm">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="mls">MLS ID</label>
                    <InputText id="mls" class="form-control" @bind-Value="property.MlsId" disabled />
                </div>

                <div class="form-group">
                    <label for="titulo">Title</label>
                    <InputText id="titulo" @bind-Value="property.Titulo" class="form-control" />
                    <ValidationMessage For="@(() => property.Titulo)" />
                </div>

                <div class="form-group">
                    <label for="descripcion">Description</label>
                    <InputTextArea id="descripcion" @bind-Value="property.Descripcion" class="form-control" rows="4" />
                    <ValidationMessage For="@(() => property.Descripcion)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Property Type</label>
                    <select class="form-select" @bind="property.Tipo_Propiedad">
                        <option value="">Select type...</option>
                        <option>Beachfront</option>
                        <option>Hotels</option>
                        <option>Homes</option>
                        <option>Condos</option>
                        <option>Golf</option>
                        <option>Mountain</option>
                        <option>City Homes</option>
                        <option>Beach Homes</option>
                        <option>Apartments</option>
                        <option>Penthouses</option>
                        <option>Farms</option>
                        <option>Business</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="precio">Price</label>
                    <InputNumber id="precio" @bind-Value="property.Precio" class="form-control" />
                    <ValidationMessage For="@(() => property.Precio)" />
                </div>

                <div class="form-group">
                    <label for="areaConstruccion">Construction Area (m²)</label>
                    <InputNumber id="areaConstruccion" @bind-Value="property.AreaConstruccion" class="form-control" />
                    <ValidationMessage For="@(() => property.AreaConstruccion)" />
                </div>

                <div class="form-group">
                    <label for="areaTerreno">Land Area (m²)</label>
                    <InputNumber id="areaTerreno" @bind-Value="property.AreaTerreno" class="form-control" />
                    <ValidationMessage For="@(() => property.AreaTerreno)" />
                </div>

                @if (role == "admin")
                {
                    <div class="form-group">
                        <label for="estadoPublicacion">Publication Status</label>
                        <InputSelect id="estadoPublicacion" @bind-Value="property.EstadoPublicacion" class="form-control">
                            <option value="">Select Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Pending">Pending</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => property.EstadoPublicacion)" />
                    </div>

                    <div class="form-group">
                        <label for="agenteId">Agent</label>
                        <InputSelect id="agenteId" @bind-Value="property.AgenteId" class="form-control">
                            <option value="">Select Agent</option>
                            @foreach (var agent in agents)
                            {
                                <option value="@agent.UsuarioId">@agent.Nombre @agent.Apellido</option>
                            }
                        </InputSelect>
                    </div>
                }
                else if (role == "seller")
                {
                    <div class="form-group">
                        <label>Publication Status</label>
                        <input class="form-control" value="@property.EstadoPublicacion" disabled />
                    </div>

                    <div class="form-group">
                        <label>Assigned Agent</label>
                        <input class="form-control" value="@(assignedAgentName ?? "Not assigned")" disabled />
                    </div>
                }
                else if (role == "agent")
                {
                    <div class="form-group">
                        <label>Publication Status</label>
                        <input class="form-control" value="@property.EstadoPublicacion" disabled />
                    </div>

                    <div class="form-group">
                        <label>Assigned Agent</label>
                        <input class="form-control" value="@(assignedAgentName ?? "Not assigned")" disabled />
                    </div>
                }

                <div class="form-group">
                    <label for="ubicacionId">Location</label>
                    <InputSelect id="ubicacionId" @bind-Value="property.UbicacionId" class="form-control">
                        <option value="">Select Location</option>
                        @foreach (var location in locations)
                        {
                            <option value="@location.UbicacionId">@location.Provincia</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-group">
                    <label>Latitude</label>
                    <InputNumber @bind-Value="property.Latitud" class="form-control" id="latInput" />
                </div>

                <div class="form-group">
                    <label>Longitude</label>
                    <InputNumber @bind-Value="property.Longitud" class="form-control" id="lngInput" />
                </div>

                <div id="map" style="height: 350px; width: 100%; margin-bottom: 20px;"></div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>

                    <a href="/properties" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    [Parameter] public int id { get; set; }

    private Propiedad? property;
    private List<Usuario> agents = new();
    private List<Ubicacion> locations = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private string errorMessage = string.Empty;
    private DotNetObjectReference<Luxprop.Pages.Properties.Edit>? objRef;

    private string role = "";
    private int currentUserId;
    private string? assignedAgentName;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        try
        {
            currentUserId = await SessionService.GetUserIdAsync();
            role = NormalizeRole(await SessionService.GetUserRoleAsync());

            locations = await db.Ubicacions.ToListAsync();

            agents = await db.Usuarios
                .Where(u =>
                    u.Activo == true &&
                    u.UsuarioRols.Any(ur =>
                        ur.Rol.Nombre.ToLower() == "agente" ||
                        ur.Rol.Nombre.ToLower() == "agent"))
                .OrderBy(u => u.Nombre)
                .ThenBy(u => u.Apellido)
                .ToListAsync();

            property = await db.Propiedads
                .Include(p => p.Agente)
                .FirstOrDefaultAsync(p => p.PropiedadId == id);

            if (property == null)
            {
                errorMessage = "Property not found.";
                return;
            }

            assignedAgentName = property.Agente != null
                ? $"{property.Agente.Nombre} {property.Agente.Apellido}"
                : null;

            // Seguridad básica por rol
            if (role == "seller" && property.SellerId != currentUserId)
            {
                errorMessage = "You do not have permission to edit this property.";
                property = null;
                return;
            }

            if (role == "agent" && property.AgenteId != currentUserId)
            {
                errorMessage = "You do not have permission to edit this property.";
                property = null;
                return;
            }

            if (role != "admin" && role != "seller" && role != "agent")
            {
                errorMessage = "You do not have permission to access this page.";
                property = null;
                return;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error loading property.";
            Console.WriteLine(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && property != null)
        {
            objRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "initEditMap",
                objRef,
                (double?)property.Latitud,
                (double?)property.Longitud
            );
        }
    }

    private async Task HandleSubmit()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            var propertyDb = await db.Propiedads.FirstOrDefaultAsync(p => p.PropiedadId == id);

            if (propertyDb == null)
            {
                errorMessage = "Property no longer exists.";
                return;
            }

            // Seguridad al guardar
            if (role == "seller" && propertyDb.SellerId != currentUserId)
            {
                errorMessage = "You do not have permission to edit this property.";
                return;
            }

            if (role == "agent" && propertyDb.AgenteId != currentUserId)
            {
                errorMessage = "You do not have permission to edit this property.";
                return;
            }

            // Campos editables para todos los roles permitidos
            propertyDb.Titulo = property!.Titulo;
            propertyDb.Descripcion = property.Descripcion;
            propertyDb.Tipo_Propiedad = property.Tipo_Propiedad;
            propertyDb.Precio = property.Precio;
            propertyDb.AreaConstruccion = property.AreaConstruccion;
            propertyDb.AreaTerreno = property.AreaTerreno;
            propertyDb.UbicacionId = property.UbicacionId;
            propertyDb.Latitud = property.Latitud;
            propertyDb.Longitud = property.Longitud;

            // Solo admin puede cambiar estado y asignar agente
            if (role == "admin")
            {
                propertyDb.EstadoPublicacion = property.EstadoPublicacion;
                propertyDb.AgenteId = property.AgenteId;
            }

            await db.SaveChangesAsync();
            Navigation.NavigateTo("/properties");
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred while saving the property.";
            Console.WriteLine(ex);
        }
        finally
        {
            isSaving = false;
        }
    }

    [JSInvokable]
    public void SetCoordinates(decimal lat, decimal lng)
    {
        if (property != null)
        {
            property.Latitud = lat;
            property.Longitud = lng;
            InvokeAsync(StateHasChanged);
        }
    }

    private static string NormalizeRole(string? name)
    {
        var n = name?.Trim().ToLowerInvariant();
        return n switch
        {
            "administrador" or "admin" => "admin",
            "agente" or "agent" => "agent",
            "seller" or "vendedor" => "seller",
            "buyer" or "comprador" => "buyer",
            _ => string.Empty
        };
    }
}