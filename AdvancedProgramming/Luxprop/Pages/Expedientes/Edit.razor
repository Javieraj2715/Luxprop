@page "/expedientes/edit/{ExpedienteId:int}"
@using Luxprop.Business.Services
@using Luxprop.Data.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LuxpropContext> DbFactory
@inject NavigationManager Navigation
@inject Luxprop.Services.SessionService Session
@inject IDocumentoService DocumentoService
@inject IJSRuntime JS

<h3 class="mb-3">Edit Case File</h3>

@if (expediente == null)
{
    <div class="alert alert-warning">Case file not found.</div>
}
else
{
    <EditForm Model="expediente" OnValidSubmit="GuardarCambios">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="card p-4 shadow-sm mb-4">
            <h5 class="fw-bold text-primary">Case File Information</h5>
            <hr />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Type of Occupation</label>
                    @if (canManageCase)
                    {
                        <InputText class="form-control" @bind-Value="expediente.TipoOcupacion" />
                    }
                    else
                    {
                        <InputText class="form-control" Value="@expediente.TipoOcupacion" disabled />
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Status</label>
                    @if (canManageCase)
                    {
                        <InputSelect class="form-select" @bind-Value="expediente.Estado">
                            <option value="Abierto">Open</option>
                            <option value="En proceso">In Progress</option>
                            <option value="Cerrado">Closed</option>
                        </InputSelect>
                    }
                    else
                    {
                        <InputText class="form-control" Value="@expediente.Estado" disabled />
                    }
                </div>
            </div>

            @if (canManageCase && expediente.Estado == "Cerrado")
            {
                <div class="mb-3">
                    <label class="form-label">Closing Date</label>
                    <InputDate class="form-control" @bind-Value="expediente.FechaCierre" />
                </div>
            }

            <label class="form-label">Description (History Log):</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="descripcionHistorial" />

            <div class="card p-4 shadow-sm mb-4">
                <h5 class="fw-bold text-primary">Documents</h5>
                <hr />

                @if (canManageDocuments)
                {
                    <div class="row g-2 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label">Select file</label>
                            <InputFile OnChange="@GuardarArchivoTemporal" class="form-control" />
                            @if (!string.IsNullOrEmpty(nombreArchivoTemporal))
                            {
                                <small class="text-success">
                                    File ready to upload: @nombreArchivoTemporal (will be saved on Save Changes)
                                </small>
                            }
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Expiration date</label>
                            <InputDate @bind-Value="fechaVencimiento" class="form-control" />
                        </div>
                    </div>
                }

                @if (documentos != null && documentos.Any())
                {
                    <table class="table modern-doc-table mt-3">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Date</th>
                                <th>Expiration</th>
                                <th>Status</th>
                                <th class="text-center" style="width:150px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var d in documentos)
                            {
                                <tr>
                                    <td>@d.Nombre</td>
                                    <td>@d.FechaCarga?.ToString("yyyy-MM-dd")</td>
                                    <td>@(d.FechaVencimiento?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td>
                                        <span class="badge status-badge">@d.Estado</span>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group-docs">
                                            @if (!string.IsNullOrEmpty(d.UrlArchivo))
                                            {
                                                <a href="@d.UrlArchivo" target="_blank" class="btn-doc btn-doc-download">
                                                    <i class="bi bi-download"></i> Download
                                                </a>
                                            }

                                            @if (canDeleteDocuments)
                                            {
                                                <button type="button"
                                                        class="btn-doc btn-doc-delete"
                                                        @onclick="() => EliminarDocumento(d.DocumentoId)">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No documents uploaded yet.</p>
                }
            </div>

            <div class="mt-3 text-end">
                <button class="btn btn-primary me-2">Save Changes</button>
                <button type="button" class="btn btn-secondary" @onclick="Volver">Cancel</button>
            </div>
        </div>
    </EditForm>

    @if (canManageTasks)
    {
        <div class="card p-4 shadow-sm mb-4">
            <h5 class="fw-bold text-primary">Process Tasks</h5>
            <hr />

            <EditForm Model="nuevaTarea" OnValidSubmit="AgregarTarea">
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <InputText class="form-control" @bind-Value="nuevaTarea.Titulo" placeholder="Task Title" />
                    </div>
                    <div class="col-md-5">
                        <InputText class="form-control" @bind-Value="nuevaTarea.Estado" placeholder="Status (Pending, Done…)" />
                    </div>

                    <div class="col-md-3">
                        <InputDate class="form-control"
                                   @bind-Value="nuevaTarea.FechaCompromiso"
                                   placeholder="Due date" />
                    </div>

                    <div class="col-md-3">
                        <InputDate class="form-control"
                                   @bind-Value="nuevaTarea.FechaCierre"
                                   placeholder="Closing date" />
                    </div>

                    <div class="col-md-2">
                        <button class="btn btn-success w-100">Add</button>
                    </div>
                </div>
            </EditForm>

            @if (tareas != null && tareas.Any())
            {
                <table class="table table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Closed</th>
                            <th style="width:100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in tareas)
                        {
                            <tr>
                                <td>@t.Titulo</td>
                                <td style="width:180px;">
                                    <InputSelect class="form-select form-select-sm"
                                                 @bind-Value="t.Estado"
                                                 @onchange="() => UpdateTaskStatus(t)">
                                        <option value="Pending">Pending</option>
                                        <option value="Done">Done</option>
                                    </InputSelect>
                                </td>
                                <td>@(t.FechaCierre?.ToString("yyyy-MM-dd") ?? "—")</td>

                                <td>
                                    <button class="btn btn-sm btn-danger" @onclick="() => EliminarTarea(t.TareaId)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No tasks registered.</p>
            }
        </div>
    }

    <div class="card p-4 shadow-sm">
        <h5 class="fw-bold text-primary">History Log</h5>
        <hr />

        @if (historial != null && historial.Any())
        {
            <table class="table table-bordered table-sm">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in historial)
                    {
                        <tr>
                            <td>@h.FechaModificacion</td>
                            <td>@h.EstadoNuevo</td>
                            <td>@h.Descripcion</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No history yet.</p>
        }
    </div>
}

@code {
    [Parameter] public int ExpedienteId { get; set; }

    private Expediente? expediente;
    private List<Documento> documentos = new();
    private List<HistorialExpediente>? historial;
    private List<TareaTramite> tareas = new();
    private DateTime? fechaVencimiento;

    private string descripcionHistorial = "";
    private TareaTramite nuevaTarea = new();
    private IBrowserFile? archivoTemporal;
    private string? nombreArchivoTemporal;

    private string role = "";
    private int currentUserId;
    private bool canAccess = false;
    private bool canManageCase = false;
    private bool canManageDocuments = false;
    private bool canManageTasks = false;
    private bool canDeleteDocuments = false;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        currentUserId = await Session.GetUserIdAsync();
        role = NormalizeRole(await Session.GetUserRoleAsync());

        expediente = await db.Expedientes
            .Include(e => e.Propiedad)
            .Include(e => e.Cliente).ThenInclude(c => c.Usuario)
            .Include(e => e.Agente)
            .Include(e => e.Documentos)
            .FirstOrDefaultAsync(e => e.ExpedienteId == ExpedienteId);

        if (expediente == null)
            return;

        canAccess = role switch
        {
            "admin" => true,
            "agent" => expediente.AgenteId == currentUserId,
            "seller" => expediente.Propiedad != null && expediente.Propiedad.SellerId == currentUserId,
            "buyer" => expediente.Cliente != null && expediente.Cliente.UsuarioId == currentUserId,
            _ => false
        };

        if (!canAccess)
        {
            expediente = null;
            Navigation.NavigateTo("/expedientes");
            return;
        }

        canManageCase = role == "admin" || role == "agent";
        canManageDocuments = role == "admin" || role == "agent" || role == "seller" || role == "buyer";
        canManageTasks = role == "admin" || role == "agent";
        canDeleteDocuments = role == "admin" || role == "agent";

        documentos = expediente.Documentos?.ToList() ?? new List<Documento>();

        tareas = await db.TareaTramites
            .Where(t => t.ExpedienteId == ExpedienteId)
            .ToListAsync();

        historial = await db.HistorialExpedientes
            .Where(h => h.ExpedienteId == ExpedienteId)
            .OrderByDescending(h => h.FechaModificacion)
            .ToListAsync();
    }

    private static string NormalizeRole(string? name)
    {
        var n = name?.Trim().ToLowerInvariant();
        return n switch
        {
            "admin" or "administrador" => "admin",
            "agent" or "agente" => "agent",
            "seller" or "vendedor" => "seller",
            "buyer" or "comprador" => "buyer",
            _ => ""
        };
    }

    private void GuardarArchivoTemporal(InputFileChangeEventArgs e)
    {
        if (!canManageDocuments) return;

        archivoTemporal = e.File;
        nombreArchivoTemporal = archivoTemporal.Name;
    }

    private async Task GuardarCambios()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        int usuarioId = await Session.GetUserIdAsync();

        var expDb = await db.Expedientes
            .FirstOrDefaultAsync(e => e.ExpedienteId == ExpedienteId);

        if (expDb == null)
        {
            await JS.InvokeVoidAsync("alert", "The case file was modified or deleted. Please reload.");
            return;
        }

        if (!canManageCase && archivoTemporal == null)
        {
            await JS.InvokeVoidAsync("alert", "You do not have permission to modify this case.");
            return;
        }

        if (canManageCase)
        {
            expDb.TipoOcupacion = expediente!.TipoOcupacion;
            expDb.Estado = expediente!.Estado;
            expDb.FechaCierre = expediente!.FechaCierre;
        }

        expDb.UltimaActualizacion = DateTime.Now;

        db.HistorialExpedientes.Add(new HistorialExpediente
        {
            ExpedienteId = expDb.ExpedienteId,
            UsuarioId = usuarioId,
            FechaModificacion = DateTime.Now,
            EstadoNuevo = expDb.Estado,
            Descripcion = string.IsNullOrWhiteSpace(descripcionHistorial) ? "Case updated." : descripcionHistorial
        });

        if (archivoTemporal != null)
        {
            using var stream = archivoTemporal.OpenReadStream(10_000_000);

            string url = await DocumentoService.UploadFileAsync(
                stream,
                archivoTemporal.Name,
                archivoTemporal.ContentType
            );

            db.Documentos.Add(new Documento
            {
                Nombre = archivoTemporal.Name,
                TipoDocumento = archivoTemporal.ContentType,
                FechaCarga = DateOnly.FromDateTime(DateTime.Now),
                Estado = "Activo",
                UrlArchivo = url,
                ExpedienteId = expDb.ExpedienteId,
                FechaVencimiento = fechaVencimiento
            });

            await DocumentoService.UpdateExpedienteStatusAsync(expDb.ExpedienteId, usuarioId);

            archivoTemporal = null;
            nombreArchivoTemporal = null;
            fechaVencimiento = null;
        }

        await db.SaveChangesAsync();
        Navigation.NavigateTo($"/expedientes/details/{expDb.ExpedienteId}");
    }

    private async Task UpdateTaskStatus(TareaTramite task)
    {
        if (!canManageTasks) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        if (task.Estado == "Done" && task.FechaCierre == null)
        {
            task.FechaCierre = DateTime.Now;
        }

        if (task.Estado == "Pending")
        {
            task.FechaCierre = null;
        }

        db.TareaTramites.Update(task);
        await db.SaveChangesAsync();
    }

    private async Task EliminarDocumento(int id)
    {
        if (!canDeleteDocuments) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        int usuarioId = await Session.GetUserIdAsync();

        var doc = await db.Documentos.FindAsync(id);
        if (doc == null) return;

        if (!string.IsNullOrEmpty(doc.UrlArchivo))
        {
            await DocumentoService.DeleteFileAsync(doc.UrlArchivo, doc.ExpedienteId, usuarioId);
        }

        db.Documentos.Remove(doc);
        await db.SaveChangesAsync();

        documentos = await db.Documentos
            .Where(d => d.ExpedienteId == ExpedienteId)
            .ToListAsync();

        await DocumentoService.UpdateExpedienteStatusAsync(ExpedienteId, usuarioId);

        expediente = await db.Expedientes
            .Include(e => e.Propiedad)
            .Include(e => e.Cliente).ThenInclude(c => c.Usuario)
            .Include(e => e.Agente)
            .Include(e => e.Documentos)
            .FirstOrDefaultAsync(e => e.ExpedienteId == ExpedienteId);

        documentos = expediente?.Documentos?.ToList() ?? new List<Documento>();
    }

    private async Task AgregarTarea()
    {
        if (!canManageTasks) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        nuevaTarea.ExpedienteId = ExpedienteId;
        nuevaTarea.FechaInicio = DateTime.Now;

        if (nuevaTarea.Estado == "Done" && nuevaTarea.FechaCierre == null)
        {
            nuevaTarea.FechaCierre = DateTime.Now;
        }

        db.TareaTramites.Add(nuevaTarea);
        await db.SaveChangesAsync();

        tareas = await db.TareaTramites
            .Where(t => t.ExpedienteId == ExpedienteId)
            .ToListAsync();

        nuevaTarea = new();
    }

    private async Task EliminarTarea(int id)
    {
        if (!canManageTasks) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var tarea = await db.TareaTramites.FindAsync(id);
        if (tarea != null)
        {
            db.TareaTramites.Remove(tarea);
            await db.SaveChangesAsync();

            tareas = await db.TareaTramites
                .Where(t => t.ExpedienteId == ExpedienteId)
                .ToListAsync();
        }
    }

    private void Volver() => Navigation.NavigateTo("/expedientes");
}

<style>
    .modern-doc-table {
        border-collapse: separate;
        border-spacing: 0 6px;
    }

        .modern-doc-table thead tr {
            background: #f5f8fa;
        }

        .modern-doc-table tbody tr {
            background: white;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        .modern-doc-table td,
        .modern-doc-table th {
            padding: 12px 16px !important;
            vertical-align: middle;
        }

    .status-badge {
        background-color: #0d505a;
        color: white;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.75rem;
    }

    .btn-group-docs {
        display: flex;
        gap: 8px;
        justify-content: center;
    }

    .btn-doc {
        padding: 5px 12px;
        font-size: 0.78rem;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        border: 2px solid transparent;
        transition: .2s ease;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .btn-doc-download {
        color: #0d505a;
        border-color: #0d505a;
        background: white;
    }

        .btn-doc-download:hover {
            background: #0d505a;
            color: white;
        }

    .btn-doc-delete {
        color: #a01d1d;
        border-color: #a01d1d;
        background: white;
    }

        .btn-doc-delete:hover {
            background: #a01d1d;
            color: white;
        }
</style>