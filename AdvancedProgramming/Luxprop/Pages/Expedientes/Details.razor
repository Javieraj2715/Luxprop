@page "/expedientes/details/{ExpedienteId:int}"
@using ClosedXML.Excel
@using Luxprop.Data.Models
@using Microsoft.EntityFrameworkCore
@using QuestPDF.Fluent
@using QuestPDF.Helpers
@inject IDbContextFactory<LuxpropContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

@using Luxprop.Business.Services
@using Luxprop.Services
@using QuestPDF.Infrastructure
@inject IExpedienteService ExpedienteService
@inject NavigationManager Navigation
@inject SessionService SessionService
@inject DocumentoService DocumentoService

<PageTitle>Case File Details</PageTitle>

@if (expediente == null)
{
    <div class="loading">Loading case file…</div>
}
else
{
    <div class="details-container">
        <div class="header-bar">
            <div>
                <h2 class="title">Case File <span class="code">@expediente.Codigo</span></h2>
                <p class="subtitle">Full record of property and document management</p>
            </div>
            <div class="btn-group">
                <button class="btn-outline" @onclick='() => Navigation.NavigateTo("/expedientes")'>
                    <i class="bi bi-arrow-left-circle"></i> Back
                </button>
                @if (canManageDocuments || canManageTasks || canEditCase)
                {
                    <button class="btn-primary"
                            @onclick='() => Navigation.NavigateTo($"/expedientes/edit/{expediente.ExpedienteId}")'>
                        <i class="bi bi-pencil-square"></i> Edit
                    </button>
                }
            </div>
        </div>

        <div class="tabs">
            <button class="@GetTabClass("info")" @onclick="@(() => Activate("info"))">Information</button>
            <button class="@GetTabClass("docs")" @onclick="@(() => Activate("docs"))">Documents</button>
            <button class="@GetTabClass("history")" @onclick="@(() => Activate("history"))">History</button>
            <button class="@GetTabClass("tasks")" @onclick="@(() => Activate("tasks"))">Tasks</button>
        </div>

        <!-- 🔹 Información -->
        @if (activeTab == "info")
        {
            <div class="card">
                <div class="info-grid">
                    <div><b>Code:</b> @expediente.Codigo</div>
                    <div><b>Property:</b> @expediente.Propiedad?.Titulo</div>
                    <div><b>Client:</b> @expediente.Cliente?.Usuario?.Nombre @expediente.Cliente?.Usuario?.Apellido</div>
                    <div><b>Agent:</b> @expediente.Agente?.Nombre @expediente.Agente?.Apellido</div>
                    <div><b>Status:</b> <span class="badge">@expediente.Estado</span></div>
                    <div><b>Priority:</b> @expediente.Prioridad</div>
                    <div><b>Category:</b> @expediente.Categoria</div>
                    <div class="full"><b>Description:</b> @expediente.Descripcion</div>
                    <div><b>Opened:</b> @expediente.FechaApertura?.ToString("yyyy-MM-dd")</div>
                    <div><b>Closed:</b> @(expediente.FechaCierre?.ToString("yyyy-MM-dd") ?? "In progress")</div>
                </div>
            </div>
        }

        <!-- 🔹 Documentos -->
        @if (activeTab == "docs")
        {
            <div class="card">

                @if (expediente.Documentos?.Any() == true)
                {
                    <table class="styled-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Uploaded</th>
                                <th>Status</th>
                                <th>Due Date</th>
                                <th style="width:220px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in expediente.Documentos.OrderByDescending(x => x.FechaCarga))
                            {
                                <tr>
                                    <td>@d.Nombre</td>

                                    <td>@(d.FechaCarga?.ToString("yyyy-MM-dd") ?? "—")</td>

                                    <td>
                                        <span class="badge">@d.Estado</span>
                                    </td>

                                    
                                    <td>
                                        @if (canManageDocuments)
                                        {
                                            <InputDate @bind-Value="d.FechaVencimiento"
                                                       class="form-control form-control-sm"
                                                       @onchange="async (_) => await SaveDueDate(d)" />
                                        }
                                        else
                                        {
                                            <span>@(d.FechaVencimiento?.ToString("yyyy-MM-dd") ?? "—")</span>
                                        }
                                    </td>

                                    <!-- 🔹 BOTONES -->
                                    <td>
                                        <div class="btn-group">

                                            <!-- Download -->
                                            @if (!string.IsNullOrWhiteSpace(d.UrlArchivo))
                                            {
                                                <button class="btn btn-sm btn-outline-info"
                                                        @onclick="() => DownloadFile(d.UrlArchivo)">
                                                    <i class="bi bi-download"></i> Download
                                                </button>

                                            }

                                            <!-- Delete -->
                                            @if (canManageDocuments)
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => ConfirmDeleteDocument(d)">
                                                    <i class="bi bi-trash"></i> Delete
                                                </button>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">No documents uploaded yet.</div>
                }
            </div>
        }


        <!-- 🔹 Historial -->
        @if (activeTab == "history")
        {
            <div class="card">
                @if (expediente.HistorialExpedientes?.Any() == true)
                {
                    <div class="row-between mb16">
                        <h3 class="section-title">History</h3>

                        @if (canExportHistory)
                        {
                            <div>
                                <button class="btn btn-secondary" @onclick="ExportHistoryExcel">Export Excel</button>
                                <button class="btn btn-primary" @onclick="ExportHistoryPdf">Export PDF</button>
                            </div>
                        }
                    </div>


                    <table class="grid">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>New Status</th>
                                <th>User</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in expediente.HistorialExpedientes.OrderByDescending(h => h.FechaModificacion))
                            {
                                <tr>
                                    <td>@h.FechaModificacion?.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><span class="badge badge-muted">@h.EstadoNuevo</span></td>
                                    <td><span class="badge badge-muted">@($"{h.Usuario!.Nombre} {h.Usuario.Apellido}")</span></td>
                                    <td>@h.Descripcion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">No history records yet.</div>
                }
            </div>
        }

        <!-- 🔹 Tareas -->
        @if (activeTab == "tasks")
        {
            <div class="card">
                <div class="header-between">
                    <h4>Tasks</h4>
                    @if (canManageTasks)
                    {
                        <button class="btn-primary btn-sm" @onclick="() => ShowTaskModal(true)">+ Add Task</button>
                    }
                </div>

                @if (tareas != null && tareas.Any())
                {
                    <table class="styled-table">
                        <thead>
                            <tr><th>Title</th><th>Status</th><th>Priority</th><th>Start</th><th>Due</th><th>Closed</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in tareas.OrderByDescending(x => x.FechaInicio))
                            {
                                <tr>
                                    <td>@t.Titulo</td>
                                    <td>@BadgeForStatus(t.Estado)</td>
                                    <td>@BadgeForPriority(t.Prioridad)</td>
                                    <td>@(t.FechaInicio?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>@(t.FechaCompromiso?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>@(t.FechaCierre?.ToString("yyyy-MM-dd") ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">No tasks yet.</div>
                }
            </div>
            @if (showTaskModal)
            {
                <div class="modal-backdrop-task">
                    <div class="modal-task card p-4">
                        <h5 class="fw-bold mb-3">Add Task</h5>

                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input class="form-control" @bind="newTask.Titulo" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Priority</label>
                            <select class="form-select" @bind="newTask.Prioridad">
                                <option value="Low">Low</option>
                                <option value="Normal">Normal</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Due date</label>
                            <input type="date" class="form-control" @bind="newTask.FechaCompromiso" />
                        </div>

                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                            <button class="btn btn-primary" @onclick="SaveTaskAsync">Save Task</button>
                        </div>
                    </div>
                </div>
            }

        }
    </div>
}

@code {
    [Parameter] public int ExpedienteId { get; set; }
    private Expediente? expediente;
    private string activeTab = "info";
    private bool showTaskModal;
    private TareaTramite newTask = new();
    
    private List<HistorialExpediente>? historial;
    private List<TareaTramite>? tasks;
    private List<Documento> documentos = new();
    private List<TareaTramite> tareas = new();
    private string role = "";
    private int currentUserId;
    private bool canAccess = false;
    private bool canEditCase = false;
    private bool canManageDocuments = false;
    private bool canManageTasks = false;
    private bool canExportHistory = false;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        currentUserId = await SessionService.GetUserIdAsync();
        role = NormalizeRole(await SessionService.GetUserRoleAsync());

        expediente = await db.Expedientes
            .Include(e => e.Propiedad)
            .Include(e => e.Cliente).ThenInclude(c => c.Usuario)
            .Include(e => e.Agente)
            .Include(e => e.Documentos)
            .Include(e => e.TareaTramites)
            .Include(e => e.HistorialExpedientes)
                .ThenInclude(h => h.Usuario)
            .FirstOrDefaultAsync(e => e.ExpedienteId == ExpedienteId);

        if (expediente == null)
            return;

        // Permisos de acceso
        canAccess = role switch
        {
            "admin" => true,
            "agent" => expediente.AgenteId == currentUserId,
            "seller" => expediente.Propiedad != null && expediente.Propiedad.SellerId == currentUserId,
            "buyer" => expediente.Cliente != null && expediente.Cliente.UsuarioId == currentUserId,
            _ => false
        };

        if (!canAccess)
        {
            expediente = null;
            Navigation.NavigateTo("/expedientes");
            return;
        }

        documentos = expediente.Documentos?.ToList() ?? new List<Documento>();
        tareas = expediente.TareaTramites?.OrderByDescending(t => t.FechaInicio).ToList() ?? new List<TareaTramite>();
        historial = expediente.HistorialExpedientes?.OrderByDescending(h => h.FechaModificacion).ToList() ?? new List<HistorialExpediente>();

        // Permisos funcionales
        canEditCase = role == "admin" || role == "agent";
        canManageDocuments = role == "admin" || role == "agent" || role == "seller" || role == "buyer";
        canManageTasks = role == "admin" || role == "agent" || role == "seller" || role == "buyer";
        canExportHistory = role == "admin" || role == "agent";
    }

    private static string NormalizeRole(string? name)
    {
        var n = name?.Trim().ToLowerInvariant();
        return n switch
        {
            "admin" or "administrador" => "admin",
            "agent" or "agente" => "agent",
            "seller" or "vendedor" => "seller",
            "buyer" or "comprador" => "buyer",
            _ => ""
        };
    }

    private void Activate(string tab) => activeTab = tab;
    private string GetTabClass(string tab) => tab == activeTab ? "tab active" : "tab";
    private string GetDownloadHref(string? f) => string.IsNullOrWhiteSpace(f) ? "#" : $"/uploads/{Uri.EscapeDataString(f)}";

    private void ShowTaskModal(bool show)
    {
        newTask = new TareaTramite
        {
            ExpedienteId = ExpedienteId,
            Estado = "Pending",
            Prioridad = "Normal",
            FechaInicio = DateTime.Now
        };
        showTaskModal = show;
    }

    private void CloseModal() => showTaskModal = false;

    private async Task DownloadFile(string url)
    {
        await JS.InvokeVoidAsync("forceDownload", url);
    }


    private async Task SaveTaskAsync()
    {
        if (!canManageTasks) return;
        if (string.IsNullOrWhiteSpace(newTask.Titulo)) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        newTask.ExpedienteId = ExpedienteId;
        newTask.FechaInicio = DateTime.Now;

        if (newTask.Estado == "Done" || newTask.Estado == "Completed")
        {
            newTask.FechaCierre = DateTime.Now;
        }

        db.TareaTramites.Add(newTask);
        await db.SaveChangesAsync();

        tareas = await db.TareaTramites
            .Where(t => t.ExpedienteId == ExpedienteId)
            .OrderByDescending(t => t.FechaInicio)
            .ToListAsync();

        newTask = new TareaTramite
        {
            ExpedienteId = ExpedienteId,
            Estado = "Pending",
            Prioridad = "Normal",
            FechaInicio = DateTime.Now
        };

        showTaskModal = false;
        activeTab = "tasks";
        StateHasChanged();
    }

    private async Task SaveDueDate(Documento d)
    {
        if (!canManageDocuments) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            db.Documentos.Update(d);
            await db.SaveChangesAsync();

            Console.WriteLine($"Due date updated for document {d.DocumentoId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error updating due date: " + ex.Message);
        }
    }

    private async Task ConfirmDeleteDocument(Documento d)
    {

        if (!canManageDocuments) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete '{d.Nombre}'?");

        if (!confirm)
            return;

        try
        {
            int usuarioId = await SessionService.GetUserIdAsync();

            if (!string.IsNullOrEmpty(d.UrlArchivo))
            {
                // borrar archivo físico
                await DocumentoService.DeleteFileAsync(d.UrlArchivo, d.ExpedienteId, usuarioId);
            }

            // borrar registro DB
            db.Documentos.Remove(d);
            await db.SaveChangesAsync();

            // refrescar la data
            expediente.Documentos.Remove(d);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error deleting document: " + ex.Message);
        }
    }

    public async Task ExportHistoryExcel()
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add("Case History");

        // =======================
        // LOGO 2CRRE
        // =======================
        var logoPath = Path.Combine(
            Directory.GetCurrentDirectory(),
            "wwwroot",
            "img",
            "logo-2crre.png"
        );

        if (File.Exists(logoPath))
        {
            var picture = ws.AddPicture(logoPath)
                .MoveTo(ws.Cell("D1"))
                .WithSize(180, 100);
        }
        ws.Row(1).Height = 35;
        ws.Row(2).Height = 35;
        ws.Row(3).Height = 35;


        // =======================
        // HEADER AREA
        // =======================
        ws.Range("A1:D3").Merge();
        ws.Range("A1:D3").Style
            .Fill.SetBackgroundColor(XLColor.FromHtml("#0D505A"))
            .Alignment.SetVertical(XLAlignmentVerticalValues.Center);

        ws.Row(1).Height = 30;
        ws.Row(2).Height = 30;
        ws.Row(3).Height = 30;

        ws.Cell("A1").Value = "CASE FILE HISTORY";
        ws.Cell("A1").Style
            .Font.SetBold()
            .Font.SetFontSize(18)
            .Font.SetFontColor(XLColor.White)
            .Alignment.SetHorizontal(XLAlignmentHorizontalValues.Left)
            .Alignment.SetIndent(2);

        ws.Cell("A2").Value = "Historical changes and status updates";
        ws.Cell("A2").Style
            .Font.SetFontSize(11)
            .Font.SetFontColor(XLColor.FromHtml("#E0F2F4"))
            .Alignment.SetHorizontal(XLAlignmentHorizontalValues.Left)
            .Alignment.SetIndent(2);

        // =======================
        // TABLE HEADER
        // =======================
        ws.Cell("A5").Value = "Date";
        ws.Cell("B5").Value = "Status";
        ws.Cell("C5").Value = "User";
        ws.Cell("D5").Value = "Description";

        ws.Range("A5:D5").Style
            .Font.SetBold()
            .Font.SetFontColor(XLColor.White)
            .Fill.SetBackgroundColor(XLColor.FromHtml("#0D505A"))
            .Alignment.SetHorizontal(XLAlignmentHorizontalValues.Center)
            .Border.SetOutsideBorder(XLBorderStyleValues.Thin);

        // =======================
        // DATA ROWS
        // =======================
        int row = 6;
        bool alternate = false;

        foreach (var h in historial)
        {
            var bgColor = alternate
                ? XLColor.FromHtml("#F1F7F8")
                : XLColor.White;

            ws.Cell(row, 1).Value = h.FechaModificacion?.ToString("yyyy-MM-dd HH:mm");
            ws.Cell(row, 2).Value = h.EstadoNuevo ?? "-";
            ws.Cell(row, 3).Value = $"{h.Usuario?.Nombre} {h.Usuario?.Apellido}";
            ws.Cell(row, 4).Value = h.Descripcion ?? "-";

            ws.Range(row, 1, row, 4).Style
                .Fill.SetBackgroundColor(bgColor)
                .Border.SetOutsideBorder(XLBorderStyleValues.Thin)
                .Alignment.SetVertical(XLAlignmentVerticalValues.Center);

            alternate = !alternate;
            row++;
        }

        // =======================
        // FINAL STYLING
        // =======================
        ws.Columns().AdjustToContents();

        ws.Column(1).Width = 20; // Date
        ws.Column(2).Width = 18; // Status
        ws.Column(3).Width = 28; // User
        ws.Column(4).Width = 60; // Description

        ws.Range($"A5:D{row - 1}")
            .Style.Border.SetOutsideBorder(XLBorderStyleValues.Medium);

        // =======================
        // SAVE & DOWNLOAD
        // =======================
        using var stream = new MemoryStream();
        wb.SaveAs(stream);

        var base64 = Convert.ToBase64String(stream.ToArray());

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"History_{DateTime.Now:yyyyMMdd}.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64
        );
    }


    private async Task ExportHistoryPdf()
    {
        var items = historial ?? new List<HistorialExpediente>();

        var logoPath = Path.Combine(
            Directory.GetCurrentDirectory(),
            "wwwroot", "img", "logo-2crre.png"
        );

        var primaryColor = "#0d505a";
        var lightBg = "#f3f8f8";
        var borderColor = "#cfdede";

        var pdfBytes = Document.Create(container =>
        {
            container.Page(page =>
            {
                page.Size(PageSizes.A4);
                page.Margin(30);
                page.DefaultTextStyle(x => x.FontSize(11));

                /* ================= HEADER ================= */
                page.Header()
                    .Background(primaryColor)
                    .PaddingVertical(16)
                    .PaddingHorizontal(24)
                    .Row(row =>
                    {
                        row.ConstantItem(100)
                            .AlignMiddle()
                            .Height(40)
                            .Image(logoPath);

                        row.RelativeItem()
                            .AlignMiddle()
                            .Column(col =>
                            {
                                col.Item().Text($"CASE FILE HISTORY #{ExpedienteId}")
                                    .FontSize(20)
                                    .Bold()
                                    .FontColor(Colors.White);

                                col.Item().Text("Historical Changes")
                                    .FontSize(12)
                                    .FontColor("#E0F2F4");
                            });
                    });

                /* ================= CONTENT ================= */
                page.Content().PaddingVertical(20).Column(column =>
                {
                    column.Item().Text("History Records")
                        .FontSize(14)
                        .Bold()
                        .FontColor(primaryColor);

                    column.Item().LineHorizontal(1)
                        .LineColor(primaryColor);

                    column.Item().PaddingTop(10);

                    column.Item().Table(table =>
                    {
                        table.ColumnsDefinition(columns =>
                        {
                            columns.ConstantColumn(70);   // History ID
                            columns.ConstantColumn(70);   // Case ID
                            columns.ConstantColumn(120);  // User
                            columns.ConstantColumn(120);  // Date
                            columns.ConstantColumn(90);   // Status
                            columns.RelativeColumn();     // Description
                        });

                        /* ===== HEADER ===== */
                        table.Header(header =>
                        {
                            HeaderCell(header, "History ID", primaryColor);
                            HeaderCell(header, "Case ID", primaryColor);
                            HeaderCell(header, "User", primaryColor);
                            HeaderCell(header, "Date", primaryColor);
                            HeaderCell(header, "Status", primaryColor);
                            HeaderCell(header, "Description", primaryColor);
                        });

                        /* ===== ROWS ===== */
                        bool alternate = false;

                        foreach (var h in items)
                        {
                            var bg = alternate ? lightBg : "#FFFFFF";

                            alternate = !alternate;

                            DataCell(table, bg, h.HistorialId.ToString());
                            DataCell(table, bg, h.ExpedienteId.ToString());
                            DataCell(table, bg, $"{h.Usuario?.Nombre} {h.Usuario?.Apellido}");
                            DataCell(table, bg, h.FechaModificacion?.ToString("yyyy-MM-dd HH:mm"));
                            DataCell(table, bg, h.EstadoNuevo);
                            DataCell(table, bg, h.Descripcion);
                        }
                    });
                });

                /* ================= FOOTER ================= */
                page.Footer()
                    .AlignCenter()
                    .Text(txt =>
                    {
                        txt.Span("2CRRE Docs • ")
                            .FontSize(9)
                            .FontColor(Colors.Grey.Medium);

                        txt.Span(DateTime.Now.ToString("yyyy-MM-dd HH:mm"))
                            .FontSize(9)
                            .FontColor(Colors.Grey.Medium);
                    });
            });
        }).GeneratePdf();

        var base64 = Convert.ToBase64String(pdfBytes);

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"History_{DateTime.Now:yyyyMMdd}.pdf",
            "application/pdf",
            base64
        );
    }


    static void HeaderCell(TableCellDescriptor header, string text, string bg)
    {
        header.Cell().Element(c => c
            .Padding(6)
            .Background(bg)
            .AlignCenter()
            .Text(text)
            .Bold()
            .FontColor(Colors.White)
        );
    }

    static void DataCell(TableDescriptor table, string bg, string? text)
    {
        table.Cell().Element(c => c
            .Padding(6)
            .Background(bg)
            .BorderBottom(1)
            .BorderColor("#cfdede")
            .Text(text ?? "-")
        );
    }


    // UI helpers for badges (render as MarkupString to keep spans)
    
    private MarkupString BadgeForStatus(string? s)
    {
        var cls = s switch
        {
            "Completed" => "badge-success",
            "In Progress" => "badge-warning",
            "On Hold" => "badge-muted",
            _ => "badge"
        };
        return new($"<span class=\"badge {cls}\">{s}</span>");
    }

    private MarkupString BadgeForPriority(string? p)
    {
        var cls = p switch
        {
            "Urgent" => "badge-danger",
            "High" => "badge-warning",
            "Low" => "badge-muted",
            _ => "badge"
        };
        return new($"<span class=\"badge {cls}\">{p}</span>");
    }
}

<style>

    /* 🔹 Modal oscuro */
    .modal-backdrop-task {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.45);
        z-index: 9000;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* 🔹 Ventana del modal */
    .modal-task {
        width: 400px;
        background: white;
        border-radius: 8px;
        z-index: 9999;
        box-shadow: 0 4px 20px rgba(0,0,0,0.18);
    }

    .details-container {
        max-width: 1150px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .header-bar {
        display: flex;
