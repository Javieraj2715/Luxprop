@page "/documents"

@using Luxprop.Data
@using Luxprop.Data.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms

@inject LuxpropContext Db

<PageTitle>Documents</PageTitle>

<div class="documents-page">

    <!-- HEADER -->
    <div class="page-head">
        <div class="page-title">
            <h1>Documents</h1>
            <p class="subtitle">Manage, upload and organize internal documents</p>
        </div>

        <div class="filters">
            <select class="form-select">
                <option>-- All Types --</option>
            </select>
            <select class="form-select">
                <option>-- All Tags --</option>
            </select>
            <select class="form-select">
                <option>-- All Status --</option>
            </select>
        </div>
    </div>

    <!-- UPLOAD CARD -->
    <div class="upload-card">
        <div class="upload-bar">
            <span class="upload-title">Upload document</span>
            <span class="upload-hint">Files are stored securely</span>
        </div>

        <div class="upload-grid">

            <div class="file-cell">
                <label class="file-label">File</label>
                <InputFile OnChange="OnFileSelected" class="file-input" />
                @if (!string.IsNullOrWhiteSpace(selectedFileName))
                {
                    <div class="file-name">@selectedFileName</div>
                }
            </div>

            <div class="field-cell">
                <label class="field-label">Tags</label>
                <input class="form-control" placeholder="comma separated" @bind="tags" />
            </div>

            <div class="field-cell">
                <label class="field-label">Expiration</label>
                <input type="date" class="form-control" @bind="expiration" />
            </div>

            <div class="btn-cell">
                <button class="btn-2cr"
                        @onclick="@UploadDocument"
                        disabled="@(!canUpload)">
                    Upload Document
                </button>
                <div class="btn-note">PDF, JPG, PNG</div>
            </div>

        </div>
    </div>

    <!-- TABLE -->
    <div class="table-wrap">
        <table class="table docs-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Tags</th>
                    <th>Status</th>
                    <th class="actions-col"></th>
                </tr>
            </thead>

            <tbody>
                @if (documents == null)
                {
                    <tr>
                        <td colspan="4">
                            <div class="state-box muted">Loading documents…</div>
                        </td>
                    </tr>
                }
                else if (!documents.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="state-box">No documents found</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var doc in documents)
                    {
                        <tr>
                            <td>
                                <div class="doc-name">@doc.Nombre</div>
                            </td>
                            <td>
                                <span class="tag-pill">General</span>
                            </td>
                            <td>Active</td>
                            <td class="actions-col">
                                <div class="row-actions">
                                    <button class="btn btn-sm btn-2cr-outline" type="button">View</button>
                                    <button class="btn btn-sm btn-2cr-danger" type="button">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    private List<Documento>? documents;

    private string? selectedFileName;
    private IBrowserFile? selectedFile;

    private string? tags;
    private DateTime? expiration;

    private bool canUpload => selectedFile != null;

    protected override async Task OnInitializedAsync()
    {
        documents = await Db.Documentos.ToListAsync();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
    }

    private async Task UploadDocument()
    {
        // ✅ Aquí conectás tu lógica real de upload.
        // Por ahora solo ejemplo para que NO falle.
        await Task.CompletedTask;
    }
}

<style>
