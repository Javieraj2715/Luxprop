@page "/documents"
@using Luxprop.Data
@using Luxprop.Data.Models
@using Microsoft.EntityFrameworkCore
@inject LuxpropContext Db

<PageTitle>Documents</PageTitle>

<DashboardHero Title="Documents"
               Subtitle="View and filter documents uploaded from case files."
               PrimaryUrl="/expedientes"
               SecondaryUrl="/expired-documents" />

<div class="documents-page">

    <!-- FILTERS -->
    <div class="filters">
        <input class="form-control" placeholder="Search by name..." @bind="filterName" />
        <input class="form-control" placeholder="Search by case file code..." @bind="filterCaseCode" />

        <select class="form-select" @bind="filterStatus">
            <option value="">-- All Status --</option>
            <option value="Activo">Active</option>
            <option value="Inactivo">Inactive</option>
            <option value="Expired">Expired</option>
        </select>

        <button type="button" class="btn btn-primary" @onclick="ApplyFilters">Apply</button>
        <button type="button" class="btn btn-secondary" @onclick="ClearFilters">Clear</button>
    </div>

    <!-- TABLE -->
    <div class="table-wrap">
        <table class="table docs-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Case File</th>
                    <th>Status</th>
                    <th>Expiration</th>
                    <th>Uploaded</th>
                </tr>
            </thead>
            <tbody>
                @if (documents == null)
                {
                    <tr><td colspan="4">Loading…</td></tr>
                }
                else if (!documents.Any())
                {
                    <tr><td colspan="4">No documents found</td></tr>
                }
                else
                {
                    @foreach (var doc in documents)
                    {
                        <tr>
                            <td>@doc.Nombre</td>
                            <td>
                                @if (doc.Expediente != null)
                                {
                                    <a href="/expedientes/details/@doc.ExpedienteId">@doc.Expediente.Codigo</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>@doc.Estado</td>
                            <td>@doc.FechaCarga</td>
                            <td>@(doc.FechaVencimiento?.ToString("yyyy-MM-dd") ?? "—")</td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Documento>? documents;

    // filters
    private string filterName = "";
    private string filterCaseCode = "";
    private string filterStatus = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        documents = await Db.Documentos
            .Include(d => d.Expediente)
            .OrderByDescending(d => d.FechaCarga)
            .ToListAsync();
    }

    private async Task ApplyFilters()
    {
        var q = Db.Documentos
            .Include(d => d.Expediente)
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(filterName))
            q = q.Where(d => d.Nombre.Contains(filterName));

        if (!string.IsNullOrWhiteSpace(filterCaseCode))
            q = q.Where(d => d.Expediente != null && d.Expediente.Codigo.Contains(filterCaseCode));

        if (!string.IsNullOrWhiteSpace(filterStatus))
            q = q.Where(d => d.Estado == filterStatus);

        documents = await q
            .OrderByDescending(d => d.FechaCarga)
            .ToListAsync();
    }

    private async Task ClearFilters()
    {
        filterName = "";
        filterCaseCode = "";
        filterStatus = "";
        await LoadDocuments();
    }
}


<style>

    .link-2cr {
        color: #0d505a;
        font-weight: 700;
        text-decoration: none;
    }

        .link-2cr:hover {
            text-decoration: underline;
        }

    .documents-page {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* FILTERS */
    .filters {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    /* UPLOAD CARD */
    .upload-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 12px 28px rgba(0,0,0,.08);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .upload-bar {
        background: linear-gradient(135deg,#0f4e56,#159d7f);
        color: #fff;
        padding: 1rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .upload-title {
        font-weight: 800;
    }

    .upload-hint {
        opacity: .85;
        font-size: .9rem;
    }

    .upload-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr .8fr auto;
        gap: 1rem;
        padding: 1.25rem;
        align-items: end;
    }

    @@media (max-width: 1000px) {
        .upload-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 600px) {
        .upload-grid {
            grid-template-columns: 1fr;
        }
    }

    /* BUTTONS */
    .btn-2cr {
        background: #0d505a;
        color: #fff;
        border-radius: 14px;
        padding: .9rem 1.2rem;
        font-weight: 800;
        width: 100%;
    }

    .btn-2cr-outline {
        border: 1px solid #0d505a;
        color: #0d505a;
        background: none;
        border-radius: 10px;
        font-weight: 700;
    }

    .btn-2cr-danger {
        border: 1px solid #b02a37;
        color: #b02a37;
        background: none;
        border-radius: 10px;
        font-weight: 700;
    }

    /* TABLE */
    .table-wrap {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .docs-table thead th {
        background: #0d505a;
        color: #fff;
        font-size: .75rem;
        text-transform: uppercase;
    }

    .doc-name {
        font-weight: 700;
    }

    .tag-pill {
        background: rgba(13,80,90,.12);
        color: #0d505a;
        padding: .25rem .6rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
    }

    .actions-col {
        width: 1%;
        white-space: nowrap;
    }

    .row-actions {
        display: flex;
        gap: .5rem;
        justify-content: flex-end;
    }

    .state-box {
        padding: 1.5rem;
        text-align: center;
        font-weight: 600;
    }

    .muted {
        color: #6b7b80;
    }
</style>
