@page "/documents"

@using Luxprop.Data
@using Luxprop.Data.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms

@inject LuxpropContext Db

<PageTitle>Documents</PageTitle>

<!-- HERO HEADER -->
<DashboardHero Title="Documents"
               Subtitle="Manage and upload case files, contracts, and related documentation."
               
               PrimaryUrl="/documents/create"
               
               SecondaryUrl="/expired-documents" />

<div class="documents-page">

    <!-- FILTERS -->
    <div class="filters">
        <select class="form-select">
            <option>-- All Types --</option>
        </select>
        <select class="form-select">
            <option>-- All Tags --</option>
        </select>
        <select class="form-select">
            <option>-- All Status --</option>
        </select>
    </div>

    <!-- UPLOAD CARD -->
    <div class="upload-card">
        <div class="upload-bar">
            <span class="upload-title">Upload document</span>
            <span class="upload-hint">Files are stored securely</span>
        </div>

        <div class="upload-grid">

            <div class="file-cell">
                <label class="file-label">File</label>
                <InputFile OnChange="OnFileSelected" class="file-input" />
                @if (!string.IsNullOrWhiteSpace(selectedFileName))
                {
                    <div class="file-name">@selectedFileName</div>
                }
            </div>

            <div class="field-cell">
                <label class="field-label">Tags</label>
                <input class="form-control"
                       placeholder="comma separated"
                       @bind="tags" />
            </div>

            <div class="field-cell">
                <label class="field-label">Expiration</label>
                <input type="date"
                       class="form-control"
                       @bind="expiration" />
            </div>

            <div class="btn-cell">
                <button class="btn-2cr"
                        @onclick="UploadDocument"
                        disabled="@(!canUpload)">
                    Upload Document
                </button>
                <div class="btn-note">PDF, JPG, PNG</div>
            </div>

        </div>
    </div>

    <!-- DOCUMENTS TABLE -->
    <div class="table-wrap">
        <table class="table docs-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Tags</th>
                    <th>Status</th>
                    <th class="actions-col"></th>
                </tr>
            </thead>

            <tbody>
                @if (documents == null)
                {
                    <tr>
                        <td colspan="4">
                            <div class="state-box muted">
                                Loading documents…
                            </div>
                        </td>
                    </tr>
                }
                else if (!documents.Any())
                {
                    <tr>
                        <td colspan="4">
                            <div class="state-box">
                                No documents found
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var doc in documents)
                    {
                        <tr>
                            <td class="doc-name">@doc.Nombre</td>
                            <td>
                                <span class="tag-pill">General</span>
                            </td>
                            <td>Active</td>
                            <td class="actions-col">
                                <div class="row-actions">
                                    <button class="btn btn-sm btn-2cr-outline">View</button>
                                    <button class="btn btn-sm btn-2cr-danger">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    private List<Documento>? documents;

    private IBrowserFile? selectedFile;
    private string? selectedFileName;

    private string? tags;
    private DateTime? expiration;

    private bool canUpload => selectedFile != null;

    protected override async Task OnInitializedAsync()
    {
        documents = await Db.Documentos.ToListAsync();
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
    }

    private async Task UploadDocument()
    {
        // 🔹 Aquí va tu lógica real de upload
        await Task.CompletedTask;
    }
}

<style>
    .documents-page {
        padding: 2rem;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* FILTERS */
    .filters {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    /* UPLOAD CARD */
    .upload-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 12px 28px rgba(0,0,0,.08);
        overflow: hidden;
        margin-bottom: 2rem;
    }

    .upload-bar {
        background: linear-gradient(135deg,#0f4e56,#159d7f);
        color: #fff;
        padding: 1rem 1.25rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .upload-title {
        font-weight: 800;
    }

    .upload-hint {
        opacity: .85;
        font-size: .9rem;
    }

    .upload-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr .8fr auto;
        gap: 1rem;
        padding: 1.25rem;
        align-items: end;
    }

    @@media (max-width: 1000px) {
        .upload-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 600px) {
        .upload-grid {
            grid-template-columns: 1fr;
        }
    }

    /* BUTTONS */
    .btn-2cr {
        background: #0d505a;
        color: #fff;
        border-radius: 14px;
        padding: .9rem 1.2rem;
        font-weight: 800;
        width: 100%;
    }

    .btn-2cr-outline {
        border: 1px solid #0d505a;
        color: #0d505a;
        background: none;
        border-radius: 10px;
        font-weight: 700;
    }

    .btn-2cr-danger {
        border: 1px solid #b02a37;
        color: #b02a37;
        background: none;
        border-radius: 10px;
        font-weight: 700;
    }

    /* TABLE */
    .table-wrap {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 10px 24px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .docs-table thead th {
        background: #0d505a;
        color: #fff;
        font-size: .75rem;
        text-transform: uppercase;
    }

    .doc-name {
        font-weight: 700;
    }

    .tag-pill {
        background: rgba(13,80,90,.12);
        color: #0d505a;
        padding: .25rem .6rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
    }

    .actions-col {
        width: 1%;
        white-space: nowrap;
    }

    .row-actions {
        display: flex;
        gap: .5rem;
        justify-content: flex-end;
    }

    .state-box {
        padding: 1.5rem;
        text-align: center;
        font-weight: 600;
    }

    .muted {
        color: #6b7b80;
    }
</style>
